GITHUB_TOKEN=insert_token_here
THEME_COLOR=0
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Your GitHub email is only ever included in the profile API/page when this is
# explicitly set to "true" — off by default to avoid handing spam bots an easy
# machine-readable copy of it. Only takes effect if the email is already public
# on your GitHub profile; GitHub's API never exposes a private email regardless.
SHOW_EMAIL=false